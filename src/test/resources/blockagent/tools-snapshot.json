  {
    "name": "build_blueprint",
    "description": "Save, build, show, modify or demolish multi-block blueprints. Building only touches natural blocks and blocks this blueprint placed. Kept after missing materials; resume by id. For a plain house use build_house.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "create: save and build. resume: continue by id. list. show: parts and site diff. update: parts replaces all or add_parts appends, then builds; own blocks no longer in the design are removed. demolish: remove own blocks matching it, then delete the record. delete: forget the record only.",
          "enum": [
            "create",
            "resume",
            "list",
            "show",
            "update",
            "demolish",
            "delete"
          ]
        },
        "id": {
          "type": "string",
          "description": "Blueprint id (resume, show, update, demolish, delete)"
        },
        "name": {
          "type": "string",
          "description": "Name (create; update renames)"
        },
        "origin": {
          "type": "string",
          "description": "Absolute origin \"x,y,z\" (create)"
        },
        "parts": {
          "type": "array",
          "description": "Whole design (create, update); later parts override earlier ones",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "description": "Relative \"x,y,z\""
              },
              "to": {
                "type": "string",
                "description": "Relative opposite corner, inclusive; omit for one block"
              },
              "block": {
                "type": "string",
                "description": "Block with optional state, e.g. oak_stairs[facing\u003dnorth]; air \u003d keep empty"
              }
            },
            "additionalProperties": false,
            "required": [
              "from",
              "block"
            ]
          },
          "minItems": 1,
          "maxItems": 256
        },
        "add_parts": {
          "type": "array",
          "description": "Parts appended to the saved design (update)",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "description": "Relative \"x,y,z\""
              },
              "to": {
                "type": "string",
                "description": "Relative opposite corner, inclusive; omit for one block"
              },
              "block": {
                "type": "string",
                "description": "Block with optional state, e.g. oak_stairs[facing\u003dnorth]; air \u003d keep empty"
              }
            },
            "additionalProperties": false,
            "required": [
              "from",
              "block"
            ]
          },
          "minItems": 1,
          "maxItems": 256
        },
        "dry_run": {
          "type": "boolean",
          "description": "Preview create, update or resume without changing anything",
          "default": false
        },
        "offset": {
          "type": "integer",
          "description": "Page start for list, show, dry_run",
          "minimum": 0,
          "maximum": 32768,
          "default": 0
        },
        "replace": {
          "type": "boolean",
          "default": false
        },
        "wait_sec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "default": 30
        }
      },
      "additionalProperties": false,
      "required": [
        "action"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
