#!/bin/sh
# 印出 Python 3.11 以上的執行檔絕對路徑(blockagent-planner 要用 tomllib；macOS 內建的 /usr/bin/python3 是 3.9)。
# BLOCKAGENT_PYTHON 可以指定(支援含空白與相對路徑)；找不到就 exit 1。
check_py() {
	path="$(command -v "$1" 2>/dev/null)" || return 1
	abs="$("$path" -I -c 'import os, sys; sys.exit(1) if sys.version_info < (3, 11) else print(os.path.abspath(sys.argv[1]))' "$path" 2>/dev/null)" || return 1
	printf '%s\n' "$abs"
	exit 0
}

if [ -n "${BLOCKAGENT_PYTHON:-}" ]; then
	check_py "$BLOCKAGENT_PYTHON"
fi
for py in python3.15 python3.14 python3.13 python3.12 python3.11 python3; do
	check_py "$py"
done
printf '%s\n' "找不到 Python 3.11 以上(規劃服務要用 tomllib)。請安裝新版 Python，或用 BLOCKAGENT_PYTHON 指定執行檔。" >&2
exit 1
