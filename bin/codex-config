#!/bin/sh
# 產生 BlockAgent 專用的 Codex config.toml(docs/SPEC.md S11.4)。
# 用法：codex-config <port> [model_provider_toml]
# 第二個參數給 CLI 測試(T8、T9)用：加上指向 stub 模型伺服器的頂層設定(只能是 key = value 或 inline table)。其他內容和正式啟動完全相同。
PORT="$1"
BIN="$(cd "$(dirname "$0")" && pwd)"
# 規劃模型預設 Sol；設成空字串(BLOCKAGENT_PLANNER_MODEL=)就不開規劃
planner_model="${BLOCKAGENT_PLANNER_MODEL-gpt-6.2-sol}"
case "$planner_model" in
	"" ) ;;
	*[!A-Za-z0-9._-]*|[!A-Za-z0-9]*)
		printf '%s\n' "codex-config: BLOCKAGENT_PLANNER_MODEL 格式錯誤" >&2
		exit 1 ;;
esac
if [ "${#planner_model}" -gt 100 ]; then
	printf '%s\n' "codex-config: BLOCKAGENT_PLANNER_MODEL 超過 100 字元" >&2
	exit 1
fi
# 遊玩模型也照同樣的格式檢查(會寫進 TOML 的字串裡)
codex_model="${BLOCKAGENT_CODEX_MODEL:-gpt-6.1-terra}"
case "$codex_model" in
	*[!A-Za-z0-9._-]*|[!A-Za-z0-9]*)
		printf '%s\n' "codex-config: BLOCKAGENT_CODEX_MODEL 格式錯誤" >&2
		exit 1 ;;
esac
if [ "${#codex_model}" -gt 100 ]; then
	printf '%s\n' "codex-config: BLOCKAGENT_CODEX_MODEL 超過 100 字元" >&2
	exit 1
fi
# 規劃服務要 Python 3.11 以上(tomllib)，以及遊戲端給的規劃 token(S11.7)
if [ -n "$planner_model" ]; then
	PYTHON="$("$BIN/python311")" || exit 1
	case "${BLOCKAGENT_PLAN_TOKEN:-}" in
		"" | *[!0-9a-f]*)
			printf '%s\n' "codex-config: 遊戲端沒有提供規劃 token(模組版本太舊？)。請更新 BlockAgent 模組，或設 BLOCKAGENT_PLANNER_MODEL= 關掉規劃" >&2
			exit 1 ;;
	esac
fi
cat <<TOML
# 由 bin/codex-config 產生，請勿手動修改
# 明確寫出模型：Codex 給模型的內建工具會隨模型改變；啟動前的快照比對(codex-tools-check)只檢查沒有快照以外的工具。
model           = "$codex_model"
# 遊玩是一個很長的回合，每次呼叫都重送整段脈絡。脈絡超過 6 萬 token 就壓縮成交接摘要，
# 不等到接近模型上限(47.5 萬)才壓縮。持久的狀態在世界記憶裡，壓縮後用 memory_read 接回來。
model_auto_compact_token_limit = 60000
compact_prompt = '''
把到目前為止的遊玩過程整理成交接摘要，讓接手的你可以直接繼續玩。只保留：
1. 長期目標、短期目標、正在做的事和下一步。
2. 重要座標：家、床、箱子、工作台、熔爐、礦坑入口、地標。
3. 朋友最近的要求、答應過的事，以及使用者給的指示。
4. 目前的血量、飢餓度、重要裝備與物資。
5. 學到的教訓：哪裡會卡住、哪些做法失敗過、為什麼。
不要逐步重述工具呼叫和回傳內容。接手後先呼叫 memory_read 和 plan，然後繼續行動或用 wait_events 等待，不要結束回合。
'''
TOML
# 「怎麼玩」提示詞(需求 6.2)：用 developer_instructions 帶入，Codex 會把它當成 developer 訊息(和 Claude 的 system prompt 同一層級)。
# 用 TOML 的多行字面字串('''…''')，內容不跳脫；檔案裡不能有連續三個單引號。
if [ -n "${PROMPT_FILE:-}" ]; then
	if grep -q "'''" "$PROMPT_FILE"; then
		printf '%s\n' "codex-config: 提示詞檔案不能有連續三個單引號：$PROMPT_FILE" >&2
		exit 1
	fi
	printf "developer_instructions = '''\n"
	cat "$PROMPT_FILE"
	cat <<'CODEX_HINTS'

## Codex 工具呼叫注意

- 查詢 `ALL_TOOLS` 時，先用 `ALL_TOOLS.map(t => t.name)` 看名稱清單，再只取出當下要用的少數工具；不要一次把整個 `ALL_TOOLS` 印出來(避免脈絡暴增與截斷)。
- 呼叫長任務(`mine`、`smelt`、`build_*`、`goto`)或 `wait_events` 時，在 `exec` 第一行加上 `// @exec: {"yield_time_ms": 120000}`，並讓 `wait_sec`/`max_wait_sec` 用預設值或 60–90 秒，不必縮短成 20 秒反覆輪詢。
CODEX_HINTS
	printf "'''\n"
fi
# 測試用的頂層設定(指向 stub 模型伺服器)必須放在任何 [table] 之前
if [ -n "${2:-}" ]; then printf '%s\n' "$2"; fi
cat "$BIN/codex-restrictions.toml"
cat <<TOML

[mcp_servers.blockagent]
url = "http://127.0.0.1:$PORT/mcp"
bearer_token_env_var = "BLOCKAGENT_TOKEN"
required = true
tool_timeout_sec = 150
# 模組的工具不需要逐一核准(approval_policy = "never" 時，沒有這行就完全不能用)
default_tools_approval_mode = "approve"
TOML

if [ -n "$planner_model" ]; then
	"$PYTHON" -I -c 'import json, sys; print("""
[mcp_servers.planner]
command = """ + json.dumps(sys.argv[4], ensure_ascii=False) + """
args = """ + json.dumps(["-I", sys.argv[1], "codex", sys.argv[2], sys.argv[5]], ensure_ascii=False) + """
env_vars = """ + json.dumps(["CODEX_HOME", "BLOCKAGENT_PLAN_TOKEN"] + (["BLOCKAGENT_TEST_PROVIDER_TOML", "STUB_API_KEY"] if sys.argv[3] else [])) + """
required = true
tool_timeout_sec = 30
enabled_tools = ["request_plan"]
default_tools_approval_mode = "approve"
""")' "$BIN/blockagent-planner" "$planner_model" "${2:-}" "$PYTHON" "$PORT"
fi
