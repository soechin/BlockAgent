#!/usr/bin/env python3
"""BlockAgent 的 stdio MCP 規劃服務。stdout 保留給 JSON-RPC。"""

import atexit
import concurrent.futures
import http.client
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import urllib.error
import urllib.request


TIMEOUT = 120
REQUEST_LIMIT = 4000
SNAPSHOT_LIMIT = 12000
GAME_TIMEOUT = 10
TOOL = {
    "name": "request_plan",
    "description": ("請規劃模型定一份計畫。立刻回傳 pending，不用等；約 10 到 60 秒後結果以 plan_ready 或 plan_stale "
                    "(失敗時 plan_failed)事件送到 wait_events。只有 plan_ready 會更新目前計畫(plan 工具)。"
                    "你的狀態、背包、記憶、目前計畫和最近的失敗會自動附上，只要寫目標；"
                    "還沒有目標(剛開始或計畫做完)時不寫 goal，由規劃模型挑下一個目標。"
                    "有快照看不出的考量(使用者或朋友的要求、你的判斷)再寫 context。"),
    "inputSchema": {
        "type": "object",
        "properties": {
            "goal": {"type": "string", "description": "要規劃的目標；不寫就由規劃模型挑"},
            "context": {"type": "string", "description": "快照看不出、但跟決策有關的事"},
            "recent_failures": {"type": "string", "description": "試過的方法和結果"},
        },
        "additionalProperties": False,
    },
}
PLAN_SCHEMA = {
    "type": "object",
    "properties": {
        "goal": {"type": "string"},
        "recommendation": {"type": "string"},
        "steps": {"type": "array", "items": {"type": "string"}},
    },
    "required": ["goal", "recommendation", "steps"],
    "additionalProperties": False,
}
PROMPT_PATH = Path(__file__).resolve().parent.parent / "prompts" / "planner.md"
PROTOCOLS = {"2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"}


def load_instructions(path=None):
    prompt_path = Path(path) if path is not None else PROMPT_PATH
    try:
        text = prompt_path.read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise PlannerError("CLI_FAILED", f"找不到規劃提示詞檔案：{prompt_path}") from exc
    if not text:
        raise PlannerError("CLI_FAILED", f"規劃提示詞檔案是空的：{prompt_path}")
    return text


class PlannerError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def checked_request(args):
    if not isinstance(args, dict) or not set(args) <= TOOL["inputSchema"]["properties"].keys():
        raise PlannerError("INVALID_ARGUMENT", "只能提供 goal、context 和 recent_failures。")
    if not all(isinstance(value, str) for value in args.values()):
        raise PlannerError("INVALID_ARGUMENT", "規劃資料必須是文字。")
    if "goal" in args and (not args["goal"].strip() or len(args["goal"]) > 500):
        raise PlannerError("INVALID_ARGUMENT", "goal 不寫或寫 1 到 500 字元。")
    if sum(map(len, args.values())) > REQUEST_LIMIT:
        raise PlannerError("INVALID_ARGUMENT", "規劃摘要合計最多 4,000 字元。")
    return args


def checked_plan(text):
    try:
        plan = json.loads(text)
        goal = plan["goal"]
        recommendation = plan["recommendation"]
        steps = plan["steps"]
        if (set(plan) != PLAN_SCHEMA["properties"].keys()
                or not isinstance(goal, str) or not goal.strip() or len(goal) > 500
                or not isinstance(recommendation, str) or not recommendation.strip()
                or not isinstance(steps, list) or not 1 <= len(steps) <= 5
                or not all(isinstance(step, str) and step.strip() and len(step) <= 500 for step in steps)
                or len(recommendation) + sum(map(len, steps)) > 1500):
            raise ValueError("unexpected plan")
    except (ValueError, KeyError, TypeError) as exc:
        raise PlannerError("INVALID_OUTPUT", "規劃模型沒有回傳合格的短計畫。") from exc
    return {"goal": goal.strip(), "recommendation": recommendation.strip(), "steps": [step.strip() for step in steps]}


def codex_restrictions():
    settings = tomllib.loads(Path(__file__).with_name("codex-restrictions.toml").read_text(encoding="utf-8"))
    # 測試注入只選模型伺服器，遊戲與規劃 MCP 設定均由各自的啟動流程控制。
    test_settings = os.environ.get("BLOCKAGENT_TEST_PROVIDER_TOML")
    if test_settings:
        provider = tomllib.loads(test_settings)
        settings.update({key: provider[key] for key in ("model_provider", "model_providers")})
    return settings


def codex_overrides(settings, prefix=""):
    args = []
    for key, value in settings.items():
        name = f"{prefix}{key}"
        if isinstance(value, dict):
            args.extend(codex_overrides(value, name + "."))
        else:
            args.extend(("-c", f"{name}={json.dumps(value, ensure_ascii=False)}"))
    return args


_FALLBACK_WORKDIR = None
# 規劃服務的私有目錄(工作目錄和用量紀錄)：Codex 用 CODEX_HOME，Claude 由 main 設成 BLOCKAGENT_HOME/claude
PLANNER_HOME = None


def planner_home():
    return PLANNER_HOME or os.environ.get("CODEX_HOME")


def planner_workdir():
    """固定的規劃工作目錄：CLI 會把 cwd 放進 prompt，每次換隨機目錄會讓快取前綴斷掉(命中率 0)。"""
    global _FALLBACK_WORKDIR
    home = planner_home()
    if home:
        candidate = Path(home, "planner-workdir")
        try:
            candidate.mkdir(mode=0o700, parents=True, exist_ok=True)
            os.chmod(candidate, 0o700)
            return candidate
        except OSError:
            pass
    if _FALLBACK_WORKDIR is None:
        _FALLBACK_WORKDIR = Path(tempfile.mkdtemp(prefix="blockagent-plan-"))
        atexit.register(shutil.rmtree, str(_FALLBACK_WORKDIR), ignore_errors=True)
    return _FALLBACK_WORKDIR


def write_if_changed(path, text):
    try:
        if path.read_text(encoding="utf-8") == text:
            return
    except OSError:
        pass
    path.write_text(text, encoding="utf-8")


def ordered_request(request):
    """靜態的快照放最前面，每次不同的目標放後面，讓輸入前綴盡量不變。"""
    ordered = {key: request[key] for key in ("game_snapshot", "goal", "context", "recent_failures") if key in request}
    ordered.update({key: value for key, value in request.items() if key not in ordered})
    return ordered


def codex_plan(model, request, usage):
    env = {key: value for key, value in os.environ.items()
           if not key.startswith("BLOCKAGENT_") and key != "PROMPT_FILE"}
    settings = codex_restrictions()
    settings["model_reasoning_effort"] = "low"
    workdir = planner_workdir()
    schema = Path(workdir, "plan.json")
    write_if_changed(schema, json.dumps(PLAN_SCHEMA))
    instructions = Path(workdir, "instructions.txt")
    write_if_changed(instructions, load_instructions())
    settings["model_instructions_file"] = str(instructions)
    argv = ["codex", "--no-daemon", "exec", "--ignore-user-config", "--ignore-rules",
            "--ephemeral", "--skip-git-repo-check", "--json", "--output-schema", str(schema),
            "--model", model, *codex_overrides(settings), "-c", "mcp_servers={}", "-"]
    try:
        result = subprocess.run(argv, input=json.dumps(ordered_request(request), ensure_ascii=False),
                                cwd=str(workdir), env=env, capture_output=True, text=True,
                                encoding="utf-8", errors="replace", timeout=TIMEOUT)
    except subprocess.TimeoutExpired as exc:
        raise PlannerError("TIMEOUT", "規劃超過 120 秒，請先依目前資訊繼續。") from exc
    except OSError as exc:
        raise PlannerError("CLI_FAILED", "無法啟動 Codex 規劃。") from exc
    last_message = None
    for line in result.stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        if event.get("type") == "turn.completed" and isinstance(event.get("usage"), dict):
            for key, value in event["usage"].items():
                if key in {"input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"} \
                        and type(value) is int and value >= 0:
                    usage[key] = usage.get(key, 0) + value
        if event.get("type") == "item.completed":
            item = event.get("item", {})
            if isinstance(item, dict) and item.get("type") == "agent_message":
                last_message = item.get("text")
    if result.returncode != 0:
        diagnostic = (result.stderr + result.stdout).lower()
        if re.search(r"\b401\b|unauthenticated|authentication required|not logged in", diagnostic):
            raise PlannerError("AUTH_FAILED", "Codex 規劃登入失效，請檢查 BlockAgent 的 Codex 登入。")
        raise PlannerError("CLI_FAILED", "Codex 規劃呼叫失敗，請檢查模型是否可用。")
    return checked_plan(last_message)


# Claude 規劃跟遊玩一樣：沒有內建工具和 MCP，不讀使用者設定；--json-schema 只留下交結果用的 StructuredOutput
CLAUDE_DENY = ["Bash", "Read", "Write", "Edit", "NotebookEdit", "Glob", "Grep",
               "WebFetch", "WebSearch", "Agent", "Task", "Skill", "TodoWrite"]


def claude_plan(model, request, usage):
    env = {key: value for key, value in os.environ.items()
           if not key.startswith("BLOCKAGENT_") and key not in {"PROMPT_FILE", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"}}
    settings = json.dumps({"permissions": {"deny": CLAUDE_DENY, "defaultMode": "dontAsk"}})
    argv = ["claude", "-p", "--output-format", "json", "--json-schema", json.dumps(PLAN_SCHEMA),
            "--model", model, "--effort", "low", "--system-prompt", load_instructions(),
            "--tools", "", "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
            "--setting-sources", "", "--settings", settings, "--permission-mode", "dontAsk",
            "--disable-slash-commands", "--no-chrome", "--no-session-persistence"]
    try:
        result = subprocess.run(argv, input=json.dumps(ordered_request(request), ensure_ascii=False),
                                cwd=str(planner_workdir()), env=env, capture_output=True, text=True,
                                encoding="utf-8", errors="replace", timeout=TIMEOUT)
    except subprocess.TimeoutExpired as exc:
        raise PlannerError("TIMEOUT", "規劃超過 120 秒，請先依目前資訊繼續。") from exc
    except OSError as exc:
        raise PlannerError("CLI_FAILED", "無法啟動 Claude 規劃。") from exc
    final = None
    try:
        output = json.loads(result.stdout)
        # 有的版本只輸出結果，有的輸出整串訊息(最後一筆是結果)
        for item in output if isinstance(output, list) else [output]:
            if isinstance(item, dict) and item.get("type") == "result":
                final = item
    except ValueError:
        pass
    if isinstance(final, dict) and isinstance(final.get("usage"), dict):
        u = final["usage"]
        counts = {key: u.get(key) if type(u.get(key)) is int and u.get(key) >= 0 else 0
                  for key in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens")}
        # 跟 Codex 一樣：input_tokens 含快取讀取的部分
        for key, value in (("input_tokens", counts["input_tokens"] + counts["cache_read_input_tokens"]
                            + counts["cache_creation_input_tokens"]),
                           ("cached_input_tokens", counts["cache_read_input_tokens"]),
                           ("output_tokens", counts["output_tokens"])):
            usage[key] = usage.get(key, 0) + value
    if result.returncode != 0 or not isinstance(final, dict) or final.get("is_error"):
        message = final.get("result") if isinstance(final, dict) and isinstance(final.get("result"), str) else ""
        diagnostic = (result.stderr + message).lower()
        if re.search(r"\b401\b|failed to authenticate|not logged in|please run /login", diagnostic):
            raise PlannerError("AUTH_FAILED", "Claude 規劃登入失效，請在終端機執行 claude 重新登入。")
        raise PlannerError("CLI_FAILED", "Claude 規劃呼叫失敗，請檢查模型是否可用。")
    plan = final.get("structured_output")
    return checked_plan(json.dumps(plan, ensure_ascii=False) if isinstance(plan, dict) else final.get("result"))


BACKENDS = {"codex": codex_plan, "claude": claude_plan}


class GameBridge:
    """遊戲端給規劃服務的兩個端點(docs/SPEC.md S11.7)。token 只能讀快照、交結果，不能呼叫遊戲工具。"""

    def __init__(self, port, token):
        self.base = f"http://127.0.0.1:{port}/plan"
        self.token = token

    def _request(self, path, body=None):
        data = None if body is None else json.dumps(body, ensure_ascii=False).encode("utf-8")
        request = urllib.request.Request(self.base + path, data=data, method="GET" if body is None else "POST",
                                         headers={"Authorization": "Bearer " + self.token,
                                                  "Content-Type": "application/json; charset=utf-8"})
        # 只連本機，不走系統的 proxy 設定
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(request, timeout=GAME_TIMEOUT) as response:
            return json.loads(response.read().decode("utf-8"))

    def context(self):
        response = self._request("/context")
        snapshot = response.get("snapshot")
        basis = response.get("basis")
        if not isinstance(snapshot, str) or (basis is not None and not isinstance(basis, dict)):
            raise ValueError("bad snapshot")
        return snapshot[:SNAPSHOT_LIMIT], basis

    def deliver(self, payload):
        self._request("/result", payload)


def tool_result(payload, is_error=False):
    return {
        "content": [{"type": "text", "text": json.dumps(payload, ensure_ascii=False)}],
        "isError": is_error,
    }


def error_result(code, message):
    return tool_result({"code": code, "message": message}, True)


def log_usage(record):
    line = json.dumps(record, ensure_ascii=False) + "\n"
    try:
        # 和規劃服務的私有目錄放在一起，兩個程序可各自附加一行。
        home = planner_home()
        if not home:
            raise KeyError("planner home")
        path = Path(home, "blockagent-planner-usage.jsonl")
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as stream:
            stream.write(line)
    except (KeyError, OSError):
        print(line, file=sys.stderr, end="", flush=True)


class Server:
    def __init__(self, model, backend, bridge, out, cli="codex"):
        self.model = model
        self.cli = cli
        self.backend = backend
        self.bridge = bridge
        self.out = out
        self.pending = None
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
        self.write_lock = threading.Lock()

    def send(self, request_id, result=None, error=None):
        response = {"jsonrpc": "2.0", "id": request_id}
        response["error" if error else "result"] = error or result
        with self.write_lock:
            print(json.dumps(response, ensure_ascii=False), file=self.out, flush=True)

    def run_plan(self, args):
        """背景執行：讀快照、問規劃模型、把結果(或失敗原因)送回遊戲。"""
        started = time.monotonic()
        usage = {}
        outcome = "ok"
        request = dict(args)
        # 沒寫目標時由規劃模型挑；有寫就以 AI 寫的為準
        goal = args.get("goal", "下一個目標")
        basis = None
        try:
            try:
                request["game_snapshot"], basis = self.bridge.context()
            except (OSError, ValueError, KeyError, TypeError, urllib.error.URLError, http.client.HTTPException):
                request["game_snapshot"] = "unavailable"
            payload = self.backend(self.model, request, usage)
            if "goal" in args:
                payload = dict(payload, goal=goal)
        except PlannerError as exc:
            outcome = exc.code
            payload = {"goal": goal, "error": {"code": exc.code, "message": str(exc)}}
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError, http.client.HTTPException):
            outcome = "INTERNAL"
            payload = {"goal": goal, "error": {"code": outcome, "message": "規劃服務設定錯誤。"}}
        if basis is not None:
            payload["basis"] = basis
        delivered = True
        try:
            self.bridge.deliver(payload)
        except (OSError, ValueError, urllib.error.URLError, http.client.HTTPException):
            delivered = False
        log_usage({"time": int(time.time()), "cli": self.cli, "model": self.model,
                   "duration_ms": round((time.monotonic() - started) * 1000),
                   "result": outcome, "delivered": delivered, "usage": usage})

    def dispatch(self, request):
        if not isinstance(request, dict) or request.get("jsonrpc") != "2.0":
            self.send(None, error={"code": -32600, "message": "Invalid Request"})
            return
        if "id" not in request:
            return  # MCP notifications
        ident = request["id"]
        method = request.get("method")
        params = request.get("params", {})
        if not isinstance(params, dict):
            self.send(ident, error={"code": -32602, "message": "Invalid params"})
        elif method == "initialize":
            version = params.get("protocolVersion")
            self.send(ident, {"protocolVersion": version if isinstance(version, str) and version in PROTOCOLS else "2025-06-18",
                              "capabilities": {"tools": {}},
                              "serverInfo": {"name": "blockagent-planner", "version": "1.0.0"}})
        elif method == "ping":
            self.send(ident, {})
        elif method == "tools/list":
            self.send(ident, {"tools": [TOOL]})
        elif method == "tools/call":
            self.call(ident, params)
        else:
            self.send(ident, error={"code": -32601, "message": "Method not found"})

    def call(self, ident, params):
        if params.get("name") != TOOL["name"]:
            self.send(ident, error={"code": -32602, "message": "Unknown tool"})
            return
        try:
            args = checked_request(params.get("arguments"))
        except PlannerError as exc:
            self.send(ident, error_result(exc.code, str(exc)))
            return
        if self.pending is not None and not self.pending.done():
            self.send(ident, error_result("BUSY", "已有一個規劃請求進行中，結果會以規劃事件送到 wait_events。"))
            return
        self.pending = self.pool.submit(self.run_plan, args)
        self.send(ident, tool_result({"status": "pending", "message": (
            "規劃中。不用等：先做安全、跟目標有關的事，結果會以 plan_ready、plan_stale 或 plan_failed 事件送到 wait_events。")}))

    def serve(self):
        with self.pool:
            for line in sys.stdin:
                try:
                    request = json.loads(line)
                except ValueError:
                    self.send(None, error={"code": -32700, "message": "Parse error"})
                    continue
                self.dispatch(request)


if __name__ == "__main__":
    # 用法：blockagent-planner <codex|claude> <模型> <遊戲 port>；規劃 token 從 BLOCKAGENT_PLAN_TOKEN 讀
    if len(sys.argv) != 4 or sys.argv[1] not in BACKENDS \
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", sys.argv[2]) \
            or not re.fullmatch(r"[0-9]{1,5}", sys.argv[3]) or not 1 <= int(sys.argv[3]) <= 65535:
        sys.exit("blockagent-planner: 用法：blockagent-planner <codex|claude> <模型> <遊戲 port>")
    plan_token = os.environ.get("BLOCKAGENT_PLAN_TOKEN", "")
    if not re.fullmatch(r"[0-9a-f]{32,128}", plan_token):
        sys.exit("blockagent-planner: 缺少 BLOCKAGENT_PLAN_TOKEN(請用新版的 BlockAgent 模組與啟動腳本)")
    if sys.argv[1] == "claude":
        if not os.environ.get("BLOCKAGENT_HOME"):
            sys.exit("blockagent-planner: Claude 規劃需要 BLOCKAGENT_HOME")
        PLANNER_HOME = str(Path(os.environ["BLOCKAGENT_HOME"], "claude"))
    try:
        load_instructions()
    except PlannerError as exc:
        sys.exit(f"blockagent-planner: {exc}")
    for name in ("BLOCKAGENT_HOME", "BLOCKAGENT_PORT", "BLOCKAGENT_TOKEN", "BLOCKAGENT_PLAN_TOKEN", "PROMPT_FILE"):
        os.environ.pop(name, None)
    Server(sys.argv[2], BACKENDS[sys.argv[1]], GameBridge(int(sys.argv[3]), plan_token), sys.stdout,
           cli=sys.argv[1]).serve()
